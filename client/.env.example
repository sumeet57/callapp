# Copy to .env (dev) or set in your host's build environment (prod).
# NOTE: VITE_* values are baked into the JS bundle. The password is a casual
# event gate, not real security: anyone can read it from the shipped code.
VITE_APP_PASSWORD=change-me

# Signaling server (use wss:// in production)
VITE_SIGNAL_URL=ws://localhost:3001

# Optional: STUN/TURN as JSON. Strongly recommended to add a TURN server for mobile networks.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
